# Multi-stage Dockerfile for FoodDelivery.Api
# Build stage with SDK
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project files and restore
COPY src/FoodDelivery.Api/FoodDelivery.Api.csproj FoodDelivery.Api/
COPY src/FoodDelivery.Shared/FoodDelivery.Shared.csproj FoodDelivery.Shared/

RUN dotnet restore FoodDelivery.Api/FoodDelivery.Api.csproj

# Copy everything and publish
COPY . .
RUN dotnet publish src/FoodDelivery.Api/FoodDelivery.Api.csproj \
    -c Release -o /app/publish --no-restore

# Runtime stage with ASP.NET Core runtime only
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Expose ports
EXPOSE 8080 5001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Copy published app
COPY --from=build /app/publish .

# Run as non-root user
USER app
ENTRYPOINT ["dotnet", "FoodDelivery.Api.dll"]
