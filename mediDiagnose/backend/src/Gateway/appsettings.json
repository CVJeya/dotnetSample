{
  "ServiceUrls": {
    "Identity": "http://identity:8080/",
    "Directory": "http://directory:8080/",
    "Appointments": "http://appointments:8080/"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-doctor-accounts": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": {
          "Path": "/api/admin/doctor-accounts/{**catch-all}"
        }
      },
      "appointments-doctor-workspace": {
        "ClusterId": "appointments",
        "Order": 0,
        "Match": {
          "Path": "/api/doctors/me/appointments"
        }
      },
      "appointments-availability": {
        "ClusterId": "appointments",
        "Order": 0,
        "Match": {
          "Path": "/api/availability/{**catch-all}"
        }
      },
      "appointments-patient-requests": {
        "ClusterId": "appointments",
        "Order": 0,
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "appointments-admin-requests": {
        "ClusterId": "appointments",
        "Order": 0,
        "Match": {
          "Path": "/api/admin/appointments/{**catch-all}"
        }
      },
      "directory-admin-doctors": {
        "ClusterId": "directory",
        "Order": 0,
        "Match": {
          "Path": "/api/admin/doctors/{**catch-all}"
        }
      },
      "directory-admin-patients": {
        "ClusterId": "directory",
        "Order": 0,
        "Match": {
          "Path": "/api/admin/patients/{**catch-all}"
        }
      },
      "directory-doctors": {
        "ClusterId": "directory",
        "Order": 100,
        "Match": {
          "Path": "/api/doctors/{**catch-all}"
        }
      },
      "directory-patients": {
        "ClusterId": "directory",
        "Order": 0,
        "Match": {
          "Path": "/api/patients/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "directory": {
        "Destinations": {
          "primary": {
            "Address": "http://directory:8080/"
          }
        }
      },
      "appointments": {
        "Destinations": {
          "primary": {
            "Address": "http://appointments:8080/"
          }
        }
      }
    }
  }
}
